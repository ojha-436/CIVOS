# Copy this file to .env and fill in the values.
# .env is gitignored — never commit secrets.

TELEGRAM_BOT_TOKEN=       # from @BotFather: /newbot

# Any random string. Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header on every update, and
# api/telegram.py rejects anything that does not match — without it
# the webhook URL is an open relay for fabricated citizen signals.
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

CIVOS_PROJECT=civos-in
CIVOS_BQ_LOCATION=asia-south1
CIVOS_BQ_DATASET=civos
CIVOS_BQ_CONNECTION=civos_vertex
CIVOS_GEMINI_MODEL=gemini-2.5-flash
